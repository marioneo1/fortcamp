# --- Local persistence ---
# Easiest local start (default):
DATABASE_URL=sqlite+aiosqlite:///./data/fortcamp.db

# To use local PostgreSQL instead, run `docker compose up -d postgres` and use:
# DATABASE_URL=postgresql+asyncpg://fortcamp:fortcamp@127.0.0.1:5432/fortcamp

# --- Discord application ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Optional: your friend server ID. Makes slash-command updates instant while testing.
DISCORD_TEST_GUILD_ID=

# Random long string. Change this before inviting anyone beyond your own testing.
APP_SESSION_SECRET=change-me-to-a-long-random-string

# Browser-only local testing. Turn FALSE when you want to require Discord authentication.
DEV_BYPASS_AUTH=true
DEV_GUILD_ID=local-guild
DEV_USER_ID=local-user
DEV_USER_NAME=Local Tester

# Set true once DISCORD_BOT_TOKEN is filled in.
BOT_ENABLED=false

# Baseline shared missions generated per guild every 30 minutes. The game adds
# four more slots per additional registered player, up to a total of 42.
MISSION_POOL_SIZE=12

# 1.0 = real mission durations. 0.05 makes a 1-minute mission take ~3 seconds for testing.
MISSION_TIME_SCALE=1.0

# Debug mission completion and pool-refresh controls. Keep FALSE for any public/release deployment.
# When TRUE, server admins can force outcomes and reroll the shared board into any event flavor.
GAME_DEBUG_MODE=false

# Optional stable Cloudflare Tunnel. Configure the tunnel and public hostname in
# Cloudflare first, then set either its token or a locally managed tunnel name.
FORTCAMP_TUNNEL_TOKEN=
FORTCAMP_TUNNEL_NAME=
FORTCAMP_PUBLIC_HOST=

# run_stable_windows.bat pins a built release on 5173 and overrides auth/debug/time
# to false/false/1.0 with data/fortcamp-stable.db. run_dev_windows.bat uses local
# 5174 + 8001, debug/auth bypass on, bot off, and data/fortcamp-dev.db.
# Both read credentials from this file; never copy secrets into a release.
